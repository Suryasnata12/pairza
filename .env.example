# Copy this file to .env in the repo root before running `docker compose up`.
# Docker Compose automatically reads a .env file in the same directory as
# docker-compose.yml and substitutes ${VARS} referenced there.

# --- Postgres ---
POSTGRES_PASSWORD=pairza_dev_password

# --- Auth ---
# Generate a real one for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# --- Google OAuth (optional) ---
# Leave blank to disable Google sign-in — email/password auth works fully
# without these. To enable it, create an OAuth Client ID at
# https://console.cloud.google.com/apis/credentials and set:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Seed data credentials (optional) ---
# Only used if you run `docker compose exec api python -m scripts.seed`.
# Loaded straight into the api container via docker-compose.yml's
# env_file — nothing about these lives in docker-compose.yml itself, so
# they never appear in git no matter what you set them to here.
# Leave commented out to use the README's documented demo/admin/seed
# credentials; uncomment and change any of these to override them —
# worth doing if this ever runs somewhere less trusted than your laptop.
# DEMO_USER_EMAIL=demo@pairza.app
# DEMO_USER_PASSWORD=PairzaDemo123!
# ADMIN_USER_EMAIL=admin@pairza.app
# ADMIN_USER_PASSWORD=PairzaAdmin123!
# SEED_USER_PASSWORD=SeedPassword123!
