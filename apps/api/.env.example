# Used when running the API directly (uvicorn app.main:app), outside Docker.
# Copy to apps/api/.env

APP_NAME=Pairza API
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:pairza_dev_password@localhost:5432/pairza
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

CORS_ORIGINS=["http://localhost:3000"]

SESSION_DURATION_HOURS=24
SESSION_EXPIRING_WARNING_MINUTES=60
MATCH_COOLDOWN_DAYS=21
MYSTERY_COOLDOWN_DAYS=30

RATE_LIMIT_MESSAGES_PER_MINUTE=60
RATE_LIMIT_AUTH_ATTEMPTS_PER_MINUTE=10

FRONTEND_URL=http://localhost:3000
