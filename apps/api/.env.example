# Used when running the API directly (uvicorn app.main:app), outside Docker.
# Copy to apps/api/.env

APP_NAME=Pairza API
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:pairza_dev_password@localhost:5432/pairza
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

CORS_ORIGINS=["http://localhost:3000"]

# How long a session lasts is NOT configured here: it comes from the mystery's difficulty
# (5 / 10 / 15 / 20 / 30 minutes for difficulty 1-5) — see app/mysteries/difficulty.py.
# (SESSION_DURATION_HOURS / SESSION_EXPIRING_WARNING_MINUTES no longer exist; leftover values are ignored.)
SESSION_SWEEP_INTERVAL_SECONDS=5
MATCH_COOLDOWN_DAYS=21
MYSTERY_COOLDOWN_DAYS=30

RATE_LIMIT_MESSAGES_PER_MINUTE=60
RATE_LIMIT_AUTH_ATTEMPTS_PER_MINUTE=10

FRONTEND_URL=http://localhost:3000

# --- Seed data credentials (scripts/seed.py only) ---
# These defaults match what the README documents. Override them if
# scripts/seed.py might ever run somewhere less trusted than your laptop.
DEMO_USER_EMAIL=demo@pairza.app
DEMO_USER_PASSWORD=PairzaDemo123!
ADMIN_USER_EMAIL=admin@pairza.app
ADMIN_USER_PASSWORD=PairzaAdmin123!
SEED_USER_PASSWORD=SeedPassword123!

# --- AI mystery generation (scripts/generate_mysteries.py only) ---
# Never used at request-serving time. Leave blank to disable generation —
# everything else in the app works fine without it; the admin panel's
# "Generate more" button will just report a clear "not configured" error
# instead of a confusing one. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
MYSTERY_GENERATOR_MODEL=claude-sonnet-4-6
# true = validated mysteries publish immediately and become playable;
# false = they stop at VALIDATED and an admin must publish each manually.
MYSTERY_AUTO_PUBLISH=true
